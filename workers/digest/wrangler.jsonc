{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "laater-crm-digest",
  "main": "index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {
    "enabled": true,
  },
  "triggers": {
    "crons": ["0 6,7 * * 1"],
  },
  "alias": {
    "$lib": "../../src/lib",
  },
  "vars": {
    "DIGEST_FROM": "crm@delaater.com",
    "DIGEST_TO": "robin@delaater.com",
    "APP_URL": "https://crm.delaater.com",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "laater-crm",
      "database_id": "67b558d6-62bb-4d91-a398-dcd4c2f9e27e",
    },
  ],
}
